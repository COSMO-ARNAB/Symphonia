server {
    listen 80;
    server_name PUBLIC_IPV4;

    location ^~ /.well-known/acme-challenge/ { root /var/www/symphonia-acme; }
    location / { return 404; }
}

server {
    listen 443 ssl;
    server_name PUBLIC_IPV4;
    ssl_certificate /etc/letsencrypt/live/PUBLIC_IPV4/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/PUBLIC_IPV4/privkey.pem;
    add_header Referrer-Policy no-referrer always;
    add_header Cache-Control no-store always;

    location = /listener.html { proxy_pass http://127.0.0.1:8081; }
    location = /mediasoup-client.esm.js { proxy_pass http://127.0.0.1:8081; }
    location = /gate2 {
        access_log off;
        error_log /dev/null crit;
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 90s;
    }
    location / { return 404; }
}
